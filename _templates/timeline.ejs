<!--
CV overview: one row per year. Data: data/timeline.yml
-->
<%
var labels = { role: 'Role', education: 'Education', award: 'Award', publication: 'Publications', talk: 'Talks', training: 'Training', service: 'Service' };
%>
<ol class="pm-years list">
<% for (const item of items) { %>
<li class="pm-year" <%= metadataAttrs(item) %>>
<div class="pm-year-label"><%= item.year %></div>
<div class="pm-year-items">
<% for (const it of (item.items || [])) { %>
<div class="pm-item"><span class="pm-type"><%= labels[it.type] || '' %></span><b><%= it.title %></b><% if (it.detail) { %><small><%= it.detail %></small><% } %></div>
<% } %>
</div>
</li>
<% } %>
</ol>
