<!--
Career timeline, driven by data/journey.yml (listed in order, newest first).
Fields per milestone: when, title, organisation, description,
image, image-alt, link, link-text, current (true for ongoing roles).
-->
<ol class="pm-timeline list">
<% for (const item of items) { %>
<li class="pm-step<%= item.current ? ' current' : '' %>" <%= metadataAttrs(item) %>>
<div class="pm-step-date"><%= item.when %></div>
<h3 class="listing-title"><%= item.title %></h3>
<% if (item.organisation) { %><p class="pm-step-org"><%= item.organisation %></p><% } %>
<div class="pm-step-body">
<% if (item.description) { %><p class="listing-description"><%= item.description %></p><% } %>
<% if (item.image) { %><img src="<%- item.image %>" alt="<%= item['image-alt'] || '' %>" loading="lazy"><% } %>
</div>
<% if (item.link) { %><div class="pm-step-links"><a href="<%- item.link %>"><%= item['link-text'] || 'Learn more' %> ›</a></div><% } %>
</li>
<% } %>
</ol>
