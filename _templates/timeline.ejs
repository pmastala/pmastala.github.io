<!--
CV at a glance: one row per year, items alternate sides on wide screens.
Data: data/timeline.yml
-->
<%
var icons = { role: 'briefcase-fill', education: 'mortarboard-fill', award: 'award-fill', publication: 'journal-text', talk: 'mic-fill', training: 'book-fill', service: 'people-fill' };
%>
<ol class="pm-years list">
<% for (const item of items) { %>
<li class="pm-year" <%= metadataAttrs(item) %>>
<div class="pm-year-label"><%= item.year %></div>
<div class="pm-year-items">
<% for (const it of (item.items || [])) { %>
<div class="pm-item"><i class="pm-ico bi bi-<%= icons[it.type] || 'dot' %>" aria-hidden="true"></i><div><b><%= it.title %></b><% if (it.detail) { %><small><%= it.detail %></small><% } %></div></div>
<% } %>
</div>
</li>
<% } %>
</ol>
