<!--
One dated CV entry per item.
Fields: when, title, org, note (one line), points (list of short bullets)
-->
<div class="list">
<% for (const item of items) { %>
<div class="pm-entry" <%= metadataAttrs(item) %>>
<div class="pm-when"><%= item.when %></div>
<div class="pm-what">
<strong class="listing-title"><%= item.title %></strong>
<% if (item.org) { %><span class="pm-org"><%= item.org %></span><% } %>
<% if (item.note) { %><p><%= item.note %></p><% } %>
<% if (item.points && item.points.length) { %><ul><% for (const p of item.points) { %><li><%= p %></li><% } %></ul><% } %>
</div>
</div>
<% } %>
</div>
